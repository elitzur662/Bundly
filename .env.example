#  Bundly â€” Environment Variables Template
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to git â€” it contains secrets.
# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

# â”€â”€ Server port â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
PORT=3001
# DO NOT SET NODE_ENV IN THIS FILE.
#
# Vite loads .env at build time and lets NODE_ENV here override `--mode
# production`, producing a "production" bundle in which import.meta.env.DEV is
# true and PROD is false. Every DEV/PROD guard in src/ then ships inverted:
# demo seed data renders to real visitors, dev-only diagnostics log in
# production, and the Stripe stub guard in App.jsx is disarmed. vite.config.js
# now fails the build rather than emitting one.
#
# Leave it unset locally (server.js treats undefined as non-production) and set
# NODE_ENV=production as a real environment variable on production hosts.
# NODE_ENV=development
# Set NODE_ENV=production on production servers to:
#   - Skip demo data seeding
#   - Enforce JWT_SECRET presence
#   - Disable debug endpoints

# â”€â”€ DataForSEO (Google Shopping search, ~$0.002/search) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Sign up at dataforseo.com â†’ Dashboard â†’ API Access
DATAFORSEO_LOGIN=your_email@domain.com
DATAFORSEO_PASSWORD=your_password

# â”€â”€ OpenAI (GPT-4o-mini for wizard questions + product reviews) â”€â”€
# Get key at platform.openai.com
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# â”€â”€ JWT Secret (CHANGE THIS IN PRODUCTION!) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-64-char-string

# â”€â”€ Admin password (for OwnerDashboard access) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Used to log into /api/admin/login. Never expose in frontend code.
ADMIN_PASSWORD=change-me-to-a-strong-admin-password

# â”€â”€ URL signing secret (HMAC) for time-limited signed URLs â”€â”€â”€â”€â”€â”€â”€
# Falls back to JWT_SECRET if not set. Used for invoice download links.
URL_SIGN_SECRET=another-random-secret-for-url-signing

# â”€â”€ hCaptcha (anti-bot) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Sign up at hcaptcha.com â†’ Dashboard â†’ Sites
# Leave empty to disable CAPTCHA (dev/testing only â€” NEVER in production)
HCAPTCHA_SECRET=0x0000000000000000000000000000000000000000
VITE_HCAPTCHA_SITEKEY=10000000-ffff-ffff-ffff-000000000001

# â”€â”€ CORS origins (comma-separated) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Additional allowed origins beyond the built-in whitelist
ALLOWED_ORIGINS=https://bundly.co,https://www.bundly.co

# â”€â”€ Redis (optional â€” multi-server rate limiting + account lockouts) â”€â”€
# Without Redis, rate limits reset on restart and don't sync across servers.
# With Redis, brute-force lockouts persist and scale horizontally.
# Format: redis://[user]:[password]@host:port or rediss:// for TLS
# REDIS_URL=redis://localhost:6379

# â”€â”€ Session (optional) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# SESSION_SECRET=another-random-string-for-session-cookies

# â”€â”€ Twilio SMS (get from twilio.com â†’ Console) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Used for: OTP login + supplier offer notifications
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TOKEN=your_auth_token
TWILIO_FROM=+1XXXXXXXXXX

# ── Transactional email via Resend ──────────────────────────────
# Used for: OTP emails, welcome, KYC decisions, supplier-offer alerts,
# order status, dispute resolution, deal-activated, docs-request.
# Sign up at resend.com, then Dashboard → API Keys → Create API Key.
# Free tier: 3,000 emails/month, generous and instant.
RESEND_API_KEY=re_REPLACE_WITH_YOUR_KEY
# Sender address. MUST be on a domain verified in Resend (Dashboard →
# Domains → Add Domain → bundly.co, then add the SPF + DKIM TXT records
# to your DNS). Until the domain is verified, leave this blank and the
# code falls back to Resend's sandbox sender, which only delivers to the
# Resend account owner's own inbox.
EMAIL_FROM=Bundly <bundly.co@bundly.co>

# â”€â”€ Stripe (payment processing) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Sign up at stripe.com â†’ Developers â†’ API keys (test mode by default).
# BOTH SECRET + PUBLISHABLE keys are required for the credit-card form
# to render Stripe's secure CardElement iframe in the browser.
# Without them, the deposit / accept-offer modals show "demo mode" and
# do not let the user enter card details (by PCI design â€” raw inputs
# would trigger Chrome's "form not secure" warning).
# Leave all empty for stub mode (dev/testing without real charges).
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_KEY
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_SECRET


# ── ZAP scraping proxy (optional) ──────────────────────────────
# When set, all ZAP fetches route through a rotating Webshare-compatible
# proxy pool to avoid Cloudflare blocks on a single IP. When unset (or
# the account is exhausted), ZAP fetches go DIRECT — which works on
# Render's static IP for casual traffic but may get rate-limited.
# Format: WEBSHARE_CREDS=user:pass
#         WEBSHARE_PROXIES=ip1:port,ip2:port,...
WEBSHARE_CREDS=
WEBSHARE_PROXIES=

# ── Admin notifications via Telegram ──────────────────────────
# Create a bot at https://t.me/BotFather → /newbot → get TOKEN.
# Start a chat with your bot, then visit
# https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
# Both must be set for notifications to fire; otherwise they are silent no-ops.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── SMS via Twilio ─────────────────────────────────────────────
# Used for OTP delivery (auth) and supplier-offer notifications to
# customers. Without these set, OTP codes are printed to the server
# console (dev only) — production should ALWAYS set Twilio.
# Sign up at https://console.twilio.com, buy a number, copy the credentials.
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=+972XXXXXXXXX

# (Resend env vars are documented near the top of this file under
#  "── Transactional email via Resend ──")

# ── Admin email shown in support footer / shipping confirmations ──
BUNDLY_SUPPORT_EMAIL=bundly.co@bundly.co
BUNDLY_SUPPORT_PHONE=

# ── Admin phone (OTP-based admin login) ────────────────────────
# When a phone matching this value verifies OTP at /api/auth/verify-otp,
# the issued JWT carries role:"admin" and the client routes to the
# OwnerDashboard. This is the SINGLE source of admin identity for the
# OTP path — leave empty to disable OTP-based admin login.
# Format: the admin's phone in any Israeli format, e.g. 0501234567
BUNDLY_ADMIN_PHONE=

# ── Render deploy hook ── OPTIONAL, used by `npm run deploy`.
#
# Auto-Deploy ("After CI Checks Pass") is the normal path: push, CI goes green,
# Render ships. This is the manual escape hatch for when CI is stuck or the
# GitHub connection breaks — on 2026-08-26 a push sat undeployed for an hour
# because Auto-Deploy was off and there was no way to trigger one without a
# browser.
#
# Dashboard → the service → Settings → Deploy Hook → reveal.
# It is a credential: anyone holding it can deploy. Keep it in .env only.
# RENDER_DEPLOY_HOOK=https://api.render.com/deploy/srv-...?key=...
