# Dependencies
node_modules/

# Environment — NEVER commit secrets
.env
.env.local
.env.*.local

# Build output
dist/
build/

# Database & caches (contain user data)
bundly-db.json
product-descriptions-cache.json
product-images-cache.json
zap-db.json
zap-prices-cache.json
wizard-cache.json
zap-filters-cache.json
zap-cache.json

# Downloaded product images (regenerated on demand)
product-img/
product-db/*/multi-img/

# Generated invoices (contain customer data)
invoices/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Tasks temporary data
tasks/

# Server runtime state — NEVER commit (regenerated on boot / mutates per request)
activity-log.json
jwt-revoked.json
search-products-cache.json
.backfill-all-progress.json
.category-prewarm-progress

# Generated/cached data (server-side enrichment, regenerated on demand)
# Track the JSON catalogs (products.json + meta.json) so Render gets a
# seed copy on deploy, but exclude the ~1.4GB of downloaded images and
# transient backup files.
product-db/*/images/
product-db/*/multi-img/
product-db/*/*.bak
product-db/*/zap_filters.json
product-db-suppliers/
zap-categories.json
zap-prices.json
ksp-cache.json
zap-wizard.json
zap-cache.db
*.migrated
.wizard-prewarm.lock

# Scraping outputs / temp data
zap_robot_vacuums/
zap_suppliers_bundly.xlsx
rep.csv

# Excel exports (large data dumps)
excel-export/
*.xlsx
